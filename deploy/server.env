PULSE_PORT=8090
PULSE_BIND=0.0.0.0
PULSE_TOKEN=__SET_BY_INSTALLER__
# REQUIRED — every dashboard-side request (API + static files) needs this key.
# Generate: python3 -c 'import secrets;print(secrets.token_hex(16))'
# PULSE_DASH_KEY is still accepted as an alias.
PULSE_API_KEY=
PULSE_STATE_DIR=/home/YOURUSER/.pulse-server
# 1 when a TLS-terminating reverse proxy (Caddy/nginx) fronts :8090 —
# Secure cookies + X-Forwarded-For client IPs. When 1, firewall the port
# to the proxy host (and your LAN).
PULSE_TLS_PROXY=0
